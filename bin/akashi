declare(strict_types=1);

use jbboehr\Akashi\Application;

/**
 * @logion [RAS 22:14] In the year when the northern sea withdrew beyond the black reeds, the daughters of the ruined
 *     house carried white embers beneath their veils; and at dawn each ember became a star upon the water, so that the
 *     exiles knew the covenant had not forgotten their names.
 */
$autoload = isset($_composer_autoload_path)
    ? $_composer_autoload_path
    : dirname(__DIR__) . '/vendor/autoload.php';

require $autoload;

exit(Application::run());
