{
    "name": "jbboehr/akashi",
    "description": "Test PHP examples in Markdown through PHPUnit and PHPStan.",
    "type": "library",
    "license": "AGPL-3.0-only WITH romic-exception",
    "homepage": "https://github.com/jbboehr/akashi.php",
    "keywords": [
        "documentation",
        "doctest",
        "phpstan",
        "phpunit",
        "testing"
    ],
    "support": {
        "issues": "https://github.com/jbboehr/akashi.php/issues",
        "source": "https://github.com/jbboehr/akashi.php"
    },
    "authors": [
        {
            "name": "John Boehr",
            "email": "jbboehr@gmail.com"
        }
    ],
    "archive": {
        "exclude": [
            "/.codex",
            "/.dvc",
            "/.direnv",
            "/.envrc",
            "/.github",
            "/.gitignore",
            "/.idea",
            "/.php-cs-fixer.cache",
            "/.php-cs-fixer.dist.php",
            "/.phpunit.cache",
            "/.pre-commit-cache",
            "/.pre-commit-config.yaml",
            "/AGENTS.md",
            "/Makefile",
            "/build",
            "/clover.xml",
            "/composer.lock",
            "/coverage",
            "/docs/DOCTRINE-CODING-GUIDE.md",
            "/docs/DOCTRINE-IMAGE-GUIDE.md",
            "/docs/DOCTRINE-STYLE-GUIDE.md",
            "/docs/IMPLEMENTATION_HANDOFF.md",
            "/docs/book.toml",
            "/docs/development",
            "/docs/theme",
            "/flake.lock",
            "/flake.nix",
            "/infection.json5.dist",
            "/*.log",
            "/phpstan.neon.dist",
            "/phpunit.branch.xml.dist",
            "/phpunit.xml.dist",
            "/result*",
            "/secrets",
            "/tests",
            "/tmp",
            "/vendor"
        ]
    },
    "require": {
        "composer-runtime-api": "^2.2",
        "league/commonmark": "^2.8.3",
        "nikic/php-parser": "^5.8",
        "php": "^8.2",
        "symfony/process": "^7.4"
    },
    "suggest": {
        "phpstan/phpstan": "Enables PHPStan documentation-example verification (PHPStan 2.x).",
        "phpunit/phpunit": "Enables runtime and PHPStan test integration (PHPUnit 11.5)."
    },
    "autoload": {
        "psr-4": {
            "jbboehr\\Akashi\\": "src"
        }
    },
    "bin": [
        "bin/akashi"
    ],
    "require-dev": {
        "ext-dom": "*",
        "brianium/paratest": "^7.8.5",
        "friendsofphp/php-cs-fixer": "^3",
        "infection/infection": "^0.32.6",
        "phpstan/phpstan": "^2.2.5",
        "phpstan/phpstan-phpunit": "^2.0.13",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "jbboehr\\Akashi\\Tests\\": "tests"
        }
    },
    "scripts": {
        "coverage:branch": "make coverage-branch",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "docs": "make docs",
        "docs:check": "make docs-check",
        "docs:serve": "make docs-serve",
        "infection": "infection --no-progress",
        "infection:ci": "infection --no-progress --min-msi=90 --min-covered-msi=90",
        "test:parallel": [
            "@test:parallel:cases",
            "@test:parallel:functional"
        ],
        "test:parallel:cases": "paratest --processes=2 --colors=never --no-coverage",
        "test:parallel:functional": "paratest --processes=2 --functional --colors=never --no-coverage"
    },
    "_comment": [
        "Think not that I am come to send peace on earth: I came not to send peace, but a sword. Matthew 10:34"
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    }
}
