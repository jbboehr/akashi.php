#!/usr/bin/env bash

set -euo pipefail

FIXTURE_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/fixture" && pwd)
readonly FIXTURE_DIR
PROJECT_ROOT=$(cd -- "$FIXTURE_DIR/../../../.." && pwd)
readonly PROJECT_ROOT
WORK_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/akashi-phpunit10.XXXXXXXX")
readonly WORK_ROOT
trap 'rm -rf -- "$WORK_ROOT"' EXIT

readonly ARCHIVE_DIR="$WORK_ROOT/archive"
readonly CONSUMER_DIR="$WORK_ROOT/consumer"
readonly PACKAGE_DIR="$WORK_ROOT/package"
mkdir -p -- "$ARCHIVE_DIR" "$CONSUMER_DIR" "$PACKAGE_DIR"

composer \
    --working-dir="$PROJECT_ROOT" \
    archive \
    --format=tar \
    --dir="$ARCHIVE_DIR" \
    --no-interaction \
    --quiet

archives=("$ARCHIVE_DIR"/*.tar)
if [[ ${#archives[@]} -ne 1 || ! -f ${archives[0]} ]]; then
    printf 'Expected exactly one Composer archive in %s.\n' "$ARCHIVE_DIR" >&2
    exit 1
fi

tar -xf "${archives[0]}" -C "$PACKAGE_DIR"
cp -R -- "$FIXTURE_DIR/." "$CONSUMER_DIR/"

# PHP expands $argv; the shell must preserve it literally.
# shellcheck disable=SC2016
repository_json=$(php -r '
echo json_encode([
    "type" => "path",
    "url" => $argv[1],
    "options" => [
        "symlink" => false,
        "versions" => ["jbboehr/akashi" => "dev-compatibility"],
    ],
], JSON_THROW_ON_ERROR);
' "$PACKAGE_DIR")
readonly repository_json

composer \
    --working-dir="$CONSUMER_DIR" \
    config \
    repositories.akashi \
    "$repository_json" \
    --no-interaction
composer --working-dir="$CONSUMER_DIR" update --prefer-dist --no-interaction --no-progress

phpunit_version=$("$CONSUMER_DIR"/vendor/bin/phpunit --version)
readonly phpunit_version
if [[ $phpunit_version != PHPUnit\ 10.* ]]; then
    printf 'Expected PHPUnit 10, got %s.\n' "$phpunit_version" >&2
    exit 1
fi

(
    cd -- "$CONSUMER_DIR"
    vendor/bin/phpunit \
        --no-configuration \
        --bootstrap vendor/autoload.php \
        --colors=never \
        --do-not-cache-result \
        --fail-on-warning \
        --fail-on-risky \
        --test-suffix Compatibility.php \
        tests
)

printf 'Akashi consumer integrations passed with %s\n' "$phpunit_version"
