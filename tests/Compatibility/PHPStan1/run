#!/usr/bin/env bash

set -euo pipefail

FIXTURE_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/fixture" && pwd)
readonly FIXTURE_DIR
SHARED_FIXTURE_DIR=$(cd -- "$FIXTURE_DIR/../../PHPUnit10/fixture" && pwd)
readonly SHARED_FIXTURE_DIR
PROJECT_ROOT=$(cd -- "$FIXTURE_DIR/../../../.." && pwd)
readonly PROJECT_ROOT
WORK_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/akashi-phpstan1.XXXXXXXX")
readonly WORK_ROOT
trap 'rm -rf -- "$WORK_ROOT"' EXIT

readonly ARCHIVE_DIR="$WORK_ROOT/archive"
readonly CONSUMER_DIR="$WORK_ROOT/consumer"
readonly PACKAGE_DIR="$WORK_ROOT/package"
readonly PACKAGE_REPOSITORY_PATH="../package"
mkdir -p -- "$ARCHIVE_DIR" "$CONSUMER_DIR" "$PACKAGE_DIR"

resolved_package_repository=$(cd -- "$CONSUMER_DIR/$PACKAGE_REPOSITORY_PATH" && pwd)
readonly resolved_package_repository
if [[ $resolved_package_repository != "$PACKAGE_DIR" ]]; then
    printf 'Package repository path %s does not resolve to %s.\n' "$PACKAGE_REPOSITORY_PATH" "$PACKAGE_DIR" >&2
    exit 1
fi

composer \
    --working-dir="$PROJECT_ROOT" \
    archive \
    --format=tar \
    --dir="$ARCHIVE_DIR" \
    --no-interaction \
    --quiet

archives=("$ARCHIVE_DIR"/*.tar)
if [[ ${#archives[@]} -ne 1 || ! -f ${archives[0]} ]]; then
    printf 'Expected exactly one Composer archive in %s.\n' "$ARCHIVE_DIR" >&2
    exit 1
fi

tar -xf "${archives[0]}" -C "$PACKAGE_DIR"
cp -R -- "$SHARED_FIXTURE_DIR/." "$CONSUMER_DIR/"
cp -- "$FIXTURE_DIR/composer.json" "$CONSUMER_DIR/composer.json"
mkdir -p -- "$CONSUMER_DIR/fixtures"
cp -- "$FIXTURE_DIR/fixtures/documentation.php.fixture" "$CONSUMER_DIR/fixtures/documentation.php"
cp -- "$FIXTURE_DIR/fixtures/phpstan-json.php.fixture" "$CONSUMER_DIR/fixtures/phpstan-json.php"

# PHP expands $argv; the shell must preserve it literally.
# shellcheck disable=SC2016
repository_json=$(php -r '
echo json_encode([
    "type" => "path",
    "url" => $argv[1],
    "options" => [
        "reference" => "none",
        "symlink" => false,
        "versions" => ["jbboehr/akashi" => "dev-compatibility"],
    ],
], JSON_THROW_ON_ERROR);
' "$PACKAGE_REPOSITORY_PATH")
readonly repository_json

composer \
    --working-dir="$CONSUMER_DIR" \
    config \
    repositories.akashi \
    "$repository_json" \
    --no-interaction

if [[ -n ${AKASHI_COMPOSER_REPOSITORY:-} ]]; then
    if [[ $AKASHI_COMPOSER_REPOSITORY != /* || ! -f $AKASHI_COMPOSER_REPOSITORY/composer.lock ]]; then
        printf 'AKASHI_COMPOSER_REPOSITORY must be an absolute Composer repository path.\n' >&2
        exit 1
    fi
    if [[ ${AKASHI_COMPOSER_LOCK:-} != /* || ! -f ${AKASHI_COMPOSER_LOCK:-} ]]; then
        printf 'AKASHI_COMPOSER_LOCK must be an absolute Composer lock-file path.\n' >&2
        exit 1
    fi

    export COMPOSER_DISABLE_NETWORK=1
    cp -- "$AKASHI_COMPOSER_LOCK" "$CONSUMER_DIR/composer.lock"
    chmod u+w "$CONSUMER_DIR/composer.lock"
    (
        cd -- "$CONSUMER_DIR"
        composer build-local-repo-lock -m "$AKASHI_COMPOSER_REPOSITORY" .
    )
    php "$PROJECT_ROOT/tests/Compatibility/assert-package-lock-current.php" \
        "$PACKAGE_DIR/composer.json" \
        "$CONSUMER_DIR/composer.lock"
    composer --working-dir="$CONSUMER_DIR" install --no-interaction --no-progress
else
    composer --working-dir="$CONSUMER_DIR" update --prefer-dist --no-interaction --no-progress
fi

phpstan_version=$(
    cd -- "$CONSUMER_DIR"
    php vendor/bin/phpstan --version
)
readonly phpstan_version
if [[ $phpstan_version != PHPStan\ -\ PHP\ Static\ Analysis\ Tool\ 1.12.* ]]; then
    printf 'Expected PHPStan 1.12, got %s.\n' "$phpstan_version" >&2
    exit 1
fi

# shellcheck disable=SC2016
parser_version=$(php -r '
require $argv[1] . "/vendor/autoload.php";
echo Composer\InstalledVersions::getPrettyVersion("nikic/php-parser");
' "$CONSUMER_DIR")
readonly parser_version
if [[ $parser_version != v4.19.* ]]; then
    printf 'Expected nikic/php-parser 4.19, got %s.\n' "$parser_version" >&2
    exit 1
fi

# The embedded PHP code must receive its dollar-prefixed variables literally.
# shellcheck disable=SC2016
php -r '
require $argv[1] . "/vendor/autoload.php";

$phpStanScript = realpath($argv[1] . "/vendor/bin/phpstan");
if (!is_string($phpStanScript)) {
    throw new RuntimeException("Unable to resolve the PHPStan compatibility fixture.");
}

$corpus = jbboehr\Akashi\Source\DocumentationSource::forProject($argv[1])
    ->withFile("fixtures/documentation.php")
    ->load();
$configuration = jbboehr\Akashi\Integration\PHPStan\PhpStanExampleConfiguration::forTokens(
    $argv[1],
    "@akashi-phpstan-example",
);
$fixtures = (new jbboehr\Akashi\Integration\PHPStan\PhpStanExternalFixturePlanner())->plan(
    $corpus,
    $configuration,
);
$fixture = realpath($argv[1] . "/fixtures/phpstan-json.php");
if (
    !is_string($fixture)
    || $fixtures->analysisPaths !== ["fixtures/phpstan-json.php"]
    || array_keys($fixtures->expectationsByFile) !== [$fixture]
) {
    throw new RuntimeException("Unexpected external PHPStan fixture plan.");
}

$result = (new jbboehr\Akashi\Integration\PHPStan\PhpStanCommandVerifier())->verifyPlanOrThrow(
    $fixtures,
    PHP_BINARY,
    [
        $phpStanScript,
        "analyse",
        "--no-progress",
        "--error-format=json",
        "--level=max",
    ],
);
if ($result->commandResult->exitCode !== 1) {
    throw new RuntimeException(sprintf(
        "Expected PHPStan JSON fixture analysis to exit 1, got %s; stdout: %s; stderr: %s.",
        var_export($result->commandResult->exitCode, true),
        var_export($result->commandResult->stdout, true),
        var_export($result->commandResult->stderr, true),
    ));
}
if (
    $result->analyzerResult->globalErrorCount !== 0
    || $result->analyzerResult->fileErrorCount < 1
    || count($result->analyzerResult->diagnosticsByFile) !== 1
) {
    throw new RuntimeException("Unexpected decoded PHPStan 1.12 result shape.");
}
if (!$result->verificationResult->isSuccessful()) {
    throw new RuntimeException(sprintf(
        "PHPStan 1.12 diagnostics did not match their expectations; global errors: %s; mismatches: %s; stderr: %s.",
        var_export($result->verificationResult->globalErrors, true),
        var_export($result->verificationResult->mismatchesByFile, true),
        var_export($result->commandResult->stderr, true),
    ));
}

$path = array_key_first($result->analyzerResult->diagnosticsByFile);
if (!is_string($path) || !str_ends_with(str_replace("\\", "/", $path), "/fixtures/phpstan-json.php")) {
    throw new RuntimeException("PHPStan 1.12 file association was not preserved.");
}

foreach ($result->analyzerResult->diagnosticsByFile[$path] as $diagnostic) {
    if ($diagnostic->analyzerLine === null || $diagnostic->ignorable === null) {
        throw new RuntimeException("PHPStan 1.12 diagnostic evidence was not preserved.");
    }
}
' "$CONSUMER_DIR"

(
    cd -- "$CONSUMER_DIR"
    php vendor/bin/phpunit \
        --no-configuration \
        --bootstrap vendor/autoload.php \
        --colors=never \
        --do-not-cache-result \
        --fail-on-warning \
        --fail-on-risky \
        --test-suffix Compatibility.php \
        tests
)

printf 'Akashi consumer integrations passed with %s and nikic/php-parser %s.\n' \
    "$phpstan_version" \
    "$parser_version"
